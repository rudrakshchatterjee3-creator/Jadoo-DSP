<?xml version="1.0" encoding="utf-8"?>
<!--
    Monochrome (themed-icon) variant. Identical geometry to
    ic_jadoo_foreground; the launcher supplies the single tint, so every path
    is white and the gold/white channel distinction is dropped.

    The mark still reads, because the two channels are distinguished by their
    BARS (flat vs bent) rather than by colour — which is exactly why the DSP
    variant was built that way.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M 24.34,54 A 18.75,18.75 0 1 1 61.84,54 A 18.75,18.75 0 1 1 24.34,54 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.69"
        android:strokeLineCap="round" />

    <path
        android:pathData="M 30.0,54 L 56.2,54"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.69"
        android:strokeLineCap="round" />

    <path
        android:pathData="M 46.17,54 A 18.75,18.75 0 1 1 83.67,54 A 18.75,18.75 0 1 1 46.17,54 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.69"
        android:strokeLineCap="round" />

