    <string name="scr_onb_headline_1">Chaque appli.\nUn meilleur son.</string>
    <string name="scr_onb_headline_2">Le casque,\nmesuré.</string>
    <string name="scr_onb_headline_3">Puis l’adapter\nà ses goûts.</string>
    <string name="scr_onb_headline_4">Rien ne quitte\nle téléphone.</string>
    <string name="scr_onb_body_1">JadOO traite en direct le son de tout ce qui est lu – appli de musique, vidéo, jeux – directement sur le téléphone.</string>
    <string name="scr_onb_body_2">Choisir son modèle parmi plus de 8 000 mesures en laboratoire : JadOO corrige sa réponse vers une cible neutre.</string>
    <string name="scr_onb_body_3">Un égaliseur graphique 15 bandes, 16 filtres paramétriques, Analog Bass, la chaleur des lampes et une scène plus large qui garde les voix centrées.</string>
    <string name="scr_onb_body_4">Pas de compte, pas de cloud, pas d’abonnement. Autoriser les notifications lorsqu’elles sont demandées : elles maintiennent le moteur actif.</string>
