    <!-- MainActivity: battery optimization dialog -->
    <string name="shr_battery_title">Akku-Optimierung deaktivieren</string>
    <string name="shr_battery_body_direct">Auf Smartphones mancher Hersteller wird die JadOO-DSP-Engine schon nach wenigen Sekunden beendet. Erlaube JadOO DSP, die Akku-Optimierung zu ignorieren, damit das DSP weiterläuft, solange Musik spielt.</string>
    <string name="shr_battery_body_settings">Auf Smartphones mancher Hersteller wird die JadOO-DSP-Engine schon nach wenigen Sekunden beendet. Suche auf dem nächsten Bildschirm JadOO DSP und stelle es auf „Nicht optimieren“, damit das DSP weiterläuft, solange Musik spielt.</string>
    <string name="shr_allow">Zulassen</string>
